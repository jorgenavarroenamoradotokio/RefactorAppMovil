<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Electra.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
        <!-- Iconos del menú y del desplegable ("⋮") en claro sobre el fondo oscuro -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
        <!-- El menú desplegable sigue el tema claro/oscuro de la app, no el de la franja -->
        <item name="popupTheme">@style/Theme.Electra</item>
    </style>

    <!--
        Fila de acción a todo el ancho (icono + texto alineados al inicio), para listas de opciones
        como las del perfil. Neutra por defecto; la variante Destructive se reserva para salir/borrar.
    -->
    <style name="Widget.Electra.Button.ListAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">@dimen/spacing_m</item>
        <item name="android:paddingEnd">@dimen/spacing_m</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/content_list_action</item>
        <item name="iconTint">@color/icon_list_action</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">@dimen/spacing_m</item>
        <item name="cornerRadius">@dimen/corner_radius_m</item>
    </style>

    <style name="Widget.Electra.Button.ListAction.Destructive">
        <item name="android:textColor">@color/destructive_list_action</item>
        <item name="iconTint">@color/destructive_list_action</item>
    </style>

    <!--
        Acción flotante principal: mismo lenguaje que los botones principales de la app (verde
        corporativo, radio M, 56dp, LabelLarge) y cede al pulsarla como ellos. Sombra fija: el
        animador de pulsación sustituye al de elevación del FAB.
    -->
    <style name="Widget.Electra.ExtendedFab.Primary" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="backgroundTint">@color/green_redur</item>
        <item name="rippleColor">@color/green_redur</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Electra.Corner.M</item>
        <item name="android:stateListAnimator">@animator/scale_on_press</item>
        <item name="android:elevation">@dimen/fab_elevation</item>
    </style>

    <style name="ShapeAppearance.Electra.Corner.M" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_m</item>
    </style>




</resources>