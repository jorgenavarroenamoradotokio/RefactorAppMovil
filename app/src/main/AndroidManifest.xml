<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Solicitud de permisos de camara, la cámara no es obligatoria para instalar la app-->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".ElectraApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Electra"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <!-- Solo vertical: la franja de marca y el panel no tienen distribución horizontal -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- Visor de la cámara (zxing): sigue la orientación del terminal en lugar de forzar horizontal -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            tools:remove="android:screenOrientation" />
    </application>

</manifest>